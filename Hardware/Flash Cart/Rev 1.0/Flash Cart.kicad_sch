	(text "Memory map\n  $C000-$DFFF   read: 8K window        write: flash WEB (JEDEC command cycles)\n  $E000-$FFFF   read: U1 bank 63       write: bank register\n\nBank register (write-only, cleared by RESB)\n  B0-B5  8K bank within a flash chip\n  B6     0 = U1 (primary), 1 = U2 (secondary)\n  B7     unused\n\nBuild variants\n  512KB  U1 = SST39SF040, U2 + C2 DNP\n  1MB    U1 = U2 = SST39SF040\n  128/256KB  U1 = SST39SF010A/020A, U2 + C2 DNP\n\nEXP0/EXP1 grounded: disables the system ROM at $C000-$FFFF."
		(exclude_from_sim no)
		(at 256.54 127 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "a07890c7-c173-521c-9d24-b76feb179ea1")
	)
